{
  "name": "agent-desktop",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "local": "npm run tauri:dev:local",
    "demo": "npm run tauri:dev:demo",
    "prod": "npm run tauri:dev:prod",
    "tauri:dev:local": "set SIGHT_SERVER_URL=ws://localhost:8080/ws&& set SIGHT_FALLBACK_URL=http://localhost:8080/config.json&& set SIGHT_FORCE_PROFILE_DEFAULTS=1&& tauri dev",
    "tauri:dev:demo": "set SIGHT_SERVER_URL=wss://sight.sanchez.ph/ws&& set SIGHT_FALLBACK_URL=https://sight.sanchez.ph/config.json&& set SIGHT_FORCE_PROFILE_DEFAULTS=1&& tauri dev --config src-tauri/tauri.demo.conf.json",
    "tauri:dev:prod": "set SIGHT_SERVER_URL=wss://sight.avegabros.org/ws&& set SIGHT_FALLBACK_URL=https://sight.avegabros.org/config.json&& set SIGHT_FORCE_PROFILE_DEFAULTS=1&& tauri dev --config src-tauri/tauri.prod.conf.json",
    "tauri:build:local": "set SIGHT_SERVER_URL=ws://localhost:8080/ws&& set SIGHT_FALLBACK_URL=http://localhost:8080/config.json&& tauri build",
    "tauri:build:demo": "set SIGHT_SERVER_URL=wss://sight.sanchez.ph/ws&& set SIGHT_FALLBACK_URL=https://sight.sanchez.ph/config.json&& tauri build --config src-tauri/tauri.demo.conf.json",
    "tauri:build:prod": "set SIGHT_SERVER_URL=wss://sight.avegabros.org/ws&& set SIGHT_FALLBACK_URL=https://sight.avegabros.org/config.json&& tauri build --config src-tauri/tauri.prod.conf.json",
    "build:local": "npm run tauri:build:local",
    "build:demo": "npm run tauri:build:demo",
    "build:prod": "npm run tauri:build:prod"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}